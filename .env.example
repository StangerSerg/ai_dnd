# ============================================================================
# AI DnD — настройки самостоятельного развёртывания (docker compose).
# Скопируйте в .env и заполните секреты:  cp .env.example .env
# Файл .env в git не попадает. НЕ коммитьте реальные ключи и пароли.
# ============================================================================

# --- PostgreSQL (сервис db) -------------------------------------------------
# Пользователь и база создаются при первом старте тома pgdata.
POSTGRES_USER=ai_dnd
# ОБЯЗАТЕЛЬНО поменяйте пароль-заглушку на свой.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_dnd

# --- Веб-интерфейс ----------------------------------------------------------
# Порт, на котором nginx отдаёт игру: http://localhost:8080
WEB_PORT=8080

# --- Основные настройки бэкенда (префикс AI_DND_) ---------------------------
# dev | test | prod. В prod cookie сессии становятся Secure — нужен HTTPS!
AI_DND_ENVIRONMENT=prod
# DEBUG | INFO | WARNING | ERROR
AI_DND_LOG_LEVEL=INFO
# console (цветной, для разработки) | json (для сервера и сбора логов)
AI_DND_LOG_FORMAT=json

# Подключения к сервисам compose (хосты db и redis — имена сервисов).
# Пароль в URL должен совпадать с POSTGRES_PASSWORD выше.
AI_DND_DATABASE_URL=postgresql+asyncpg://ai_dnd:change-me@db:5432/ai_dnd
AI_DND_REDIS_URL=redis://redis:6379/0

# Секрет подписи сессий и токенов identity. ОБЯЗАТЕЛЬНО поменяйте:
# длинная случайная строка, например `openssl rand -hex 32`.
AI_DND_SECRET_KEY=change-me

# Ключ DeepSeek (https://platform.deepseek.com/api_keys).
# Без него ИИ-функции не работают, остальное — работает.
AI_DND_DEEPSEEK_API_KEY=change-me

# Публичный адрес портала (ссылки в письмах подтверждения email).
AI_DND_BASE_URL=http://localhost:8080

# --- Прод-флаги -------------------------------------------------------------
# Демо-регистрация без подтверждения email. Только для локальных экспериментов!
AI_DND_DEMO_AUTH=false
# Модель-заглушка вместо реального LLM (бесплатно, без сети). В проде — false.
AI_DND_FAKE_LLM=false

# --- Контент и модели (обычно менять не нужно) ------------------------------
# Папка со встроенным контентом. В образе уже лежит /app/content — дефолт.
# AI_DND_CONTENT_DIR=/app/content
# Модели, цены и настройки задач ИИ. В образе — backend/config/llm.yaml.
# AI_DND_LLM_CONFIG=/app/backend/config/llm.yaml
# Многоязычная модель эмбеддингов для поиска по сценарию (считает воркер на CPU).
# AI_DND_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# AI_DND_EMBEDDING_DIM=384

# --- Оркестрация хода (префикс AI_DND_) -------------------------------------
# Окно сбора действий игроков, секунды.
# AI_DND_TURN_WINDOW_SECONDS=180
# Замок комнаты на время хода, миллисекунды (страховка от зависшего воркера).
# AI_DND_TURN_LOCK_MS=180000

# --- Биллинг (префикс AI_DND_BILLING_) — щедрые дефолты для альфа-тестирования
# Тестировщики не платят: кредиты не должны блокировать игру. Курс: 1 кредит =
# $0.0001 (10 000 кредитов = $1).
# AI_DND_BILLING_CREDIT_USD=0.0001
# Ежедневные бесплатные кредиты: 100 000 = $10 в день.
AI_DND_BILLING_DAILY_FREE_CREDITS=100000
# Резерв на один AI-вызов, кредиты.
# AI_DND_BILLING_RESERVE_CREDITS=50
# Лимиты расхода: пользователь в день/месяц, сессия в день (кредиты).
AI_DND_BILLING_USER_DAILY_SPEND_CREDITS=100000
AI_DND_BILLING_USER_MONTHLY_SPEND_CREDITS=1000000
AI_DND_BILLING_SESSION_DAILY_SPEND_CREDITS=100000
# Глобальные предохранители платформы по фактическим расходам, USD:
# защита реального баланса провайдера, потолок поднят для альфы.
AI_DND_BILLING_GLOBAL_DAILY_USD=20.00
AI_DND_BILLING_GLOBAL_MONTHLY_USD=300.00
# Порог уведомления админу о низком балансе у провайдера, USD.
# AI_DND_BILLING_PROVIDER_BALANCE_ALERT_USD=2.00

# --- Identity: сессии и письма (префикс AI_DND_) ----------------------------
# AI_DND_SESSION_TTL_DAYS=30
# AI_DND_EMAIL_TOKEN_TTL_HOURS=48
# AI_DND_INVITE_TOKEN_TTL_DAYS=7
# SMTP для писем подтверждения (в prod без DEMO_AUTH регистрация требует email).
# AI_DND_SMTP_HOST=smtp.example.com
# AI_DND_SMTP_PORT=587
# AI_DND_SMTP_USER=change-me
# AI_DND_SMTP_PASSWORD=change-me
# AI_DND_SMTP_FROM=no-reply@example.com
# OAuth (необязательно).
# AI_DND_DISCORD_CLIENT_ID=
# AI_DND_DISCORD_CLIENT_SECRET=
# AI_DND_GOOGLE_CLIENT_ID=
# AI_DND_GOOGLE_CLIENT_SECRET=