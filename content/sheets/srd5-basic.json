{
  "id": "srd5-basic",
  "version": 1,
  "name": {"ru": "5e SRD (базовый)", "en": "5e SRD (basic)"},
  "ruleset": "dnd5e-srd@1",
  "fields": [
    {"id": "name", "type": "text", "label": {"ru": "Имя", "en": "Name"}},
    {"id": "race", "type": "text", "label": {"ru": "Раса", "en": "Race"}},
    {"id": "char_class", "type": "text", "label": {"ru": "Класс", "en": "Class"}},
    {"id": "background", "type": "text", "label": {"ru": "Предыстория", "en": "Background"}},
    {"id": "alignment", "type": "text", "label": {"ru": "Мировоззрение", "en": "Alignment"}},
    {"id": "level", "type": "number", "label": {"ru": "Уровень", "en": "Level"}, "default": 1, "min": 1, "max": 20},
    {"id": "xp", "type": "number", "label": {"ru": "Опыт", "en": "Experience"}, "default": 0, "min": 0, "max": 1000000},
    {"id": "portrait", "type": "image", "label": {"ru": "Портрет", "en": "Portrait"}},
    {"id": "inspiration", "type": "checkbox", "label": {"ru": "Вдохновение", "en": "Inspiration"}},
    {"id": "str", "type": "number", "label": {"ru": "Сила", "en": "Strength"}, "default": 10, "min": 1, "max": 30},
    {"id": "dex", "type": "number", "label": {"ru": "Ловкость", "en": "Dexterity"}, "default": 10, "min": 1, "max": 30},
    {"id": "con", "type": "number", "label": {"ru": "Телосложение", "en": "Constitution"}, "default": 10, "min": 1, "max": 30},
    {"id": "int", "type": "number", "label": {"ru": "Интеллект", "en": "Intelligence"}, "default": 10, "min": 1, "max": 30},
    {"id": "wis", "type": "number", "label": {"ru": "Мудрость", "en": "Wisdom"}, "default": 10, "min": 1, "max": 30},
    {"id": "cha", "type": "number", "label": {"ru": "Харизма", "en": "Charisma"}, "default": 10, "min": 1, "max": 30},
    {"id": "str_mod", "type": "computed", "label": {"ru": "Модификатор Силы", "en": "Strength modifier"}, "formula": "floor((str - 10) / 2)"},
    {"id": "dex_mod", "type": "computed", "label": {"ru": "Модификатор Ловкости", "en": "Dexterity modifier"}, "formula": "floor((dex - 10) / 2)"},
    {"id": "con_mod", "type": "computed", "label": {"ru": "Модификатор Телосложения", "en": "Constitution modifier"}, "formula": "floor((con - 10) / 2)"},
    {"id": "int_mod", "type": "computed", "label": {"ru": "Модификатор Интеллекта", "en": "Intelligence modifier"}, "formula": "floor((int - 10) / 2)"},
    {"id": "wis_mod", "type": "computed", "label": {"ru": "Модификатор Мудрости", "en": "Wisdom modifier"}, "formula": "floor((wis - 10) / 2)"},
    {"id": "cha_mod", "type": "computed", "label": {"ru": "Модификатор Харизмы", "en": "Charisma modifier"}, "formula": "floor((cha - 10) / 2)"},
    {"id": "prof", "type": "computed", "label": {"ru": "Бонус мастерства", "en": "Proficiency bonus"}, "formula": "2 + floor((level - 1) / 4)"},
    {"id": "save_str_prof", "type": "checkbox", "label": {"ru": "Владение спасбросками Силы", "en": "Strength saving throw proficiency"}},
    {"id": "save_str", "type": "computed", "label": {"ru": "Спасбросок Силы", "en": "Strength saving throw"}, "formula": "str_mod + (prof if save_str_prof else 0)"},
    {"id": "save_dex_prof", "type": "checkbox", "label": {"ru": "Владение спасбросками Ловкости", "en": "Dexterity saving throw proficiency"}},
    {"id": "save_dex", "type": "computed", "label": {"ru": "Спасбросок Ловкости", "en": "Dexterity saving throw"}, "formula": "dex_mod + (prof if save_dex_prof else 0)"},
    {"id": "save_con_prof", "type": "checkbox", "label": {"ru": "Владение спасбросками Телосложения", "en": "Constitution saving throw proficiency"}},
    {"id": "save_con", "type": "computed", "label": {"ru": "Спасбросок Телосложения", "en": "Constitution saving throw"}, "formula": "con_mod + (prof if save_con_prof else 0)"},
    {"id": "save_int_prof", "type": "checkbox", "label": {"ru": "Владение спасбросками Интеллекта", "en": "Intelligence saving throw proficiency"}},
    {"id": "save_int", "type": "computed", "label": {"ru": "Спасбросок Интеллекта", "en": "Intelligence saving throw"}, "formula": "int_mod + (prof if save_int_prof else 0)"},
    {"id": "save_wis_prof", "type": "checkbox", "label": {"ru": "Владение спасбросками Мудрости", "en": "Wisdom saving throw proficiency"}},
    {"id": "save_wis", "type": "computed", "label": {"ru": "Спасбросок Мудрости", "en": "Wisdom saving throw"}, "formula": "wis_mod + (prof if save_wis_prof else 0)"},
    {"id": "save_cha_prof", "type": "checkbox", "label": {"ru": "Владение спасбросками Харизмы", "en": "Charisma saving throw proficiency"}},
    {"id": "save_cha", "type": "computed", "label": {"ru": "Спасбросок Харизмы", "en": "Charisma saving throw"}, "formula": "cha_mod + (prof if save_cha_prof else 0)"},
    {"id": "acrobatics_prof", "type": "select", "label": {"ru": "Владение: Акробатика", "en": "Acrobatics proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "acrobatics", "type": "computed", "label": {"ru": "Акробатика", "en": "Acrobatics"}, "formula": "dex_mod + prof * (2 if acrobatics_prof == \"expertise\" else 1 if acrobatics_prof == \"proficient\" else 0)"},
    {"id": "animal_handling_prof", "type": "select", "label": {"ru": "Владение: Уход за животными", "en": "Animal Handling proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "animal_handling", "type": "computed", "label": {"ru": "Уход за животными", "en": "Animal Handling"}, "formula": "wis_mod + prof * (2 if animal_handling_prof == \"expertise\" else 1 if animal_handling_prof == \"proficient\" else 0)"},
    {"id": "arcana_prof", "type": "select", "label": {"ru": "Владение: Магия", "en": "Arcana proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "arcana", "type": "computed", "label": {"ru": "Магия", "en": "Arcana"}, "formula": "int_mod + prof * (2 if arcana_prof == \"expertise\" else 1 if arcana_prof == \"proficient\" else 0)"},
    {"id": "athletics_prof", "type": "select", "label": {"ru": "Владение: Атлетика", "en": "Athletics proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "athletics", "type": "computed", "label": {"ru": "Атлетика", "en": "Athletics"}, "formula": "str_mod + prof * (2 if athletics_prof == \"expertise\" else 1 if athletics_prof == \"proficient\" else 0)"},
    {"id": "deception_prof", "type": "select", "label": {"ru": "Владение: Обман", "en": "Deception proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "deception", "type": "computed", "label": {"ru": "Обман", "en": "Deception"}, "formula": "cha_mod + prof * (2 if deception_prof == \"expertise\" else 1 if deception_prof == \"proficient\" else 0)"},
    {"id": "history_prof", "type": "select", "label": {"ru": "Владение: История", "en": "History proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "history", "type": "computed", "label": {"ru": "История", "en": "History"}, "formula": "int_mod + prof * (2 if history_prof == \"expertise\" else 1 if history_prof == \"proficient\" else 0)"},
    {"id": "insight_prof", "type": "select", "label": {"ru": "Владение: Проницательность", "en": "Insight proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "insight", "type": "computed", "label": {"ru": "Проницательность", "en": "Insight"}, "formula": "wis_mod + prof * (2 if insight_prof == \"expertise\" else 1 if insight_prof == \"proficient\" else 0)"},
    {"id": "intimidation_prof", "type": "select", "label": {"ru": "Владение: Запугивание", "en": "Intimidation proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "intimidation", "type": "computed", "label": {"ru": "Запугивание", "en": "Intimidation"}, "formula": "cha_mod + prof * (2 if intimidation_prof == \"expertise\" else 1 if intimidation_prof == \"proficient\" else 0)"},
    {"id": "investigation_prof", "type": "select", "label": {"ru": "Владение: Расследование", "en": "Investigation proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "investigation", "type": "computed", "label": {"ru": "Расследование", "en": "Investigation"}, "formula": "int_mod + prof * (2 if investigation_prof == \"expertise\" else 1 if investigation_prof == \"proficient\" else 0)"},
    {"id": "medicine_prof", "type": "select", "label": {"ru": "Владение: Медицина", "en": "Medicine proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "medicine", "type": "computed", "label": {"ru": "Медицина", "en": "Medicine"}, "formula": "wis_mod + prof * (2 if medicine_prof == \"expertise\" else 1 if medicine_prof == \"proficient\" else 0)"},
    {"id": "nature_prof", "type": "select", "label": {"ru": "Владение: Природа", "en": "Nature proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "nature", "type": "computed", "label": {"ru": "Природа", "en": "Nature"}, "formula": "int_mod + prof * (2 if nature_prof == \"expertise\" else 1 if nature_prof == \"proficient\" else 0)"},
    {"id": "perception_prof", "type": "select", "label": {"ru": "Владение: Восприятие", "en": "Perception proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "perception", "type": "computed", "label": {"ru": "Восприятие", "en": "Perception"}, "formula": "wis_mod + prof * (2 if perception_prof == \"expertise\" else 1 if perception_prof == \"proficient\" else 0)"},
    {"id": "performance_prof", "type": "select", "label": {"ru": "Владение: Выступление", "en": "Performance proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "performance", "type": "computed", "label": {"ru": "Выступление", "en": "Performance"}, "formula": "cha_mod + prof * (2 if performance_prof == \"expertise\" else 1 if performance_prof == \"proficient\" else 0)"},
    {"id": "persuasion_prof", "type": "select", "label": {"ru": "Владение: Убеждение", "en": "Persuasion proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "persuasion", "type": "computed", "label": {"ru": "Убеждение", "en": "Persuasion"}, "formula": "cha_mod + prof * (2 if persuasion_prof == \"expertise\" else 1 if persuasion_prof == \"proficient\" else 0)"},
    {"id": "religion_prof", "type": "select", "label": {"ru": "Владение: Религия", "en": "Religion proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "religion", "type": "computed", "label": {"ru": "Религия", "en": "Religion"}, "formula": "int_mod + prof * (2 if religion_prof == \"expertise\" else 1 if religion_prof == \"proficient\" else 0)"},
    {"id": "sleight_of_hand_prof", "type": "select", "label": {"ru": "Владение: Ловкость рук", "en": "Sleight of Hand proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "sleight_of_hand", "type": "computed", "label": {"ru": "Ловкость рук", "en": "Sleight of Hand"}, "formula": "dex_mod + prof * (2 if sleight_of_hand_prof == \"expertise\" else 1 if sleight_of_hand_prof == \"proficient\" else 0)"},
    {"id": "stealth_prof", "type": "select", "label": {"ru": "Владение: Скрытность", "en": "Stealth proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "stealth", "type": "computed", "label": {"ru": "Скрытность", "en": "Stealth"}, "formula": "dex_mod + prof * (2 if stealth_prof == \"expertise\" else 1 if stealth_prof == \"proficient\" else 0)"},
    {"id": "survival_prof", "type": "select", "label": {"ru": "Владение: Выживание", "en": "Survival proficiency"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "proficient", "label": {"ru": "Владение", "en": "Proficient"}}, {"value": "expertise", "label": {"ru": "Компетентность", "en": "Expertise"}}]},
    {"id": "survival", "type": "computed", "label": {"ru": "Выживание", "en": "Survival"}, "formula": "wis_mod + prof * (2 if survival_prof == \"expertise\" else 1 if survival_prof == \"proficient\" else 0)"},
    {"id": "passive_perception", "type": "computed", "label": {"ru": "Пассивное Восприятие", "en": "Passive Perception"}, "formula": "10 + perception"},
    {"id": "armor_type", "type": "select", "label": {"ru": "Тип доспеха", "en": "Armor type"}, "options": [{"value": "none", "label": {"ru": "Без доспеха", "en": "No armor"}}, {"value": "light", "label": {"ru": "Лёгкий", "en": "Light"}}, {"value": "medium", "label": {"ru": "Средний", "en": "Medium"}}, {"value": "heavy", "label": {"ru": "Тяжёлый", "en": "Heavy"}}]},
    {"id": "armor_base", "type": "number", "label": {"ru": "Базовый КД доспеха", "en": "Armor base AC"}, "default": 10, "min": 0, "max": 30},
    {"id": "shield", "type": "checkbox", "label": {"ru": "Щит", "en": "Shield"}},
    {"id": "ac_bonus", "type": "number", "label": {"ru": "Прочие бонусы к КД", "en": "Other AC bonuses"}, "default": 0, "min": -20, "max": 20},
    {"id": "ac", "type": "computed", "label": {"ru": "Класс доспеха (КД)", "en": "Armor Class (AC)"}, "formula": "armor_base + (0 if armor_type == \"heavy\" else min(dex_mod, 2) if armor_type == \"medium\" else dex_mod) + (2 if shield else 0) + ac_bonus"},
    {"id": "initiative", "type": "computed", "label": {"ru": "Инициатива", "en": "Initiative"}, "formula": "dex_mod"},
    {"id": "speed", "type": "number", "label": {"ru": "Скорость (фт)", "en": "Speed (ft)"}, "default": 30, "min": 0, "max": 500},
    {"id": "hit_die", "type": "number", "label": {"ru": "Кость хитов (граней)", "en": "Hit die (sides)"}, "default": 8, "min": 4, "max": 12},
    {"id": "hp_bonus", "type": "number", "label": {"ru": "Поправка к максимуму хитов", "en": "Hit point maximum adjustment"}, "default": 0, "min": -100, "max": 500},
    {"id": "hp", "type": "resource", "label": {"ru": "Хиты", "en": "Hit Points"}, "max_formula": "max(1, max(1, hit_die + con_mod) + (level - 1) * max(1, floor(hit_die / 2) + 1 + con_mod) + hp_bonus)"},
    {"id": "temp_hp", "type": "number", "label": {"ru": "Временные хиты", "en": "Temporary hit points"}, "default": 0, "min": 0, "max": 1000},
    {"id": "hit_dice", "type": "resource", "label": {"ru": "Кости хитов", "en": "Hit Dice"}, "max_formula": "level"},
    {"id": "attacks", "type": "list", "label": {"ru": "Атаки", "en": "Attacks"}, "item": {"name": {"type": "text", "label": {"ru": "Название", "en": "Name"}}, "bonus": {"type": "number", "label": {"ru": "Бонус атаки", "en": "Attack bonus"}}, "damage": {"type": "text", "label": {"ru": "Урон", "en": "Damage"}}, "damage_type": {"type": "text", "label": {"ru": "Тип урона", "en": "Damage type"}}, "notes": {"type": "text", "label": {"ru": "Заметки", "en": "Notes"}}}},
    {"id": "spell_ability", "type": "select", "label": {"ru": "Базовая характеристика заклинаний", "en": "Spellcasting ability"}, "options": [{"value": "none", "label": {"ru": "Нет", "en": "None"}}, {"value": "int", "label": {"ru": "Интеллект", "en": "Intelligence"}}, {"value": "wis", "label": {"ru": "Мудрость", "en": "Wisdom"}}, {"value": "cha", "label": {"ru": "Харизма", "en": "Charisma"}}]},
    {"id": "spell_mod", "type": "computed", "label": {"ru": "Модификатор заклинаний", "en": "Spellcasting modifier"}, "formula": "int_mod if spell_ability == \"int\" else wis_mod if spell_ability == \"wis\" else cha_mod if spell_ability == \"cha\" else 0"},
    {"id": "spell_save_dc", "type": "computed", "label": {"ru": "Сложность спасброска от заклинаний", "en": "Spell save DC"}, "formula": "8 + prof + spell_mod"},
    {"id": "spell_attack", "type": "computed", "label": {"ru": "Бонус атаки заклинанием", "en": "Spell attack bonus"}, "formula": "prof + spell_mod"},
    {"id": "spell_slots_1", "type": "resource", "label": {"ru": "Ячейки заклинаний: 1 уровень", "en": "Spell slots: level 1"}},
    {"id": "spell_slots_2", "type": "resource", "label": {"ru": "Ячейки заклинаний: 2 уровень", "en": "Spell slots: level 2"}},
    {"id": "spell_slots_3", "type": "resource", "label": {"ru": "Ячейки заклинаний: 3 уровень", "en": "Spell slots: level 3"}},
    {"id": "spell_slots_4", "type": "resource", "label": {"ru": "Ячейки заклинаний: 4 уровень", "en": "Spell slots: level 4"}},
    {"id": "spell_slots_5", "type": "resource", "label": {"ru": "Ячейки заклинаний: 5 уровень", "en": "Spell slots: level 5"}},
    {"id": "spell_slots_6", "type": "resource", "label": {"ru": "Ячейки заклинаний: 6 уровень", "en": "Spell slots: level 6"}},
    {"id": "spell_slots_7", "type": "resource", "label": {"ru": "Ячейки заклинаний: 7 уровень", "en": "Spell slots: level 7"}},
    {"id": "spell_slots_8", "type": "resource", "label": {"ru": "Ячейки заклинаний: 8 уровень", "en": "Spell slots: level 8"}},
    {"id": "spell_slots_9", "type": "resource", "label": {"ru": "Ячейки заклинаний: 9 уровень", "en": "Spell slots: level 9"}},
    {"id": "spells", "type": "list", "label": {"ru": "Заклинания", "en": "Spells"}, "item": {"name": {"type": "text", "label": {"ru": "Название", "en": "Name"}}, "level": {"type": "number", "label": {"ru": "Уровень", "en": "Level"}}, "prepared": {"type": "checkbox", "label": {"ru": "Подготовлено", "en": "Prepared"}}, "notes": {"type": "text", "label": {"ru": "Заметки", "en": "Notes"}}}},
    {"id": "gp", "type": "number", "label": {"ru": "Золотые монеты", "en": "Gold pieces"}, "default": 0, "min": 0, "max": 1000000},
    {"id": "inventory", "type": "list", "label": {"ru": "Снаряжение", "en": "Equipment"}, "item": {"name": {"type": "text", "label": {"ru": "Название", "en": "Name"}}, "qty": {"type": "number", "label": {"ru": "Кол-во", "en": "Qty"}}, "notes": {"type": "text", "label": {"ru": "Заметки", "en": "Notes"}}}},
    {"id": "features", "type": "longtext", "label": {"ru": "Умения и особенности", "en": "Features & traits"}},
    {"id": "proficiencies", "type": "longtext", "label": {"ru": "Владения и языки", "en": "Proficiencies & languages"}},
    {"id": "notes", "type": "longtext", "label": {"ru": "Заметки", "en": "Notes"}}
