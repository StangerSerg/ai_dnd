{
  "id": "worms-ship",
  "version": 1,
  "name": {"ru": "Корабль «Черви»"},
  "ruleset": "worms-space@1",
  "fields": [
    {"id": "name", "type": "text", "label": {"ru": "Название корабля"}},
    {"id": "race", "type": "text", "label": {"ru": "Тип корпуса"}},
    {"id": "char_class", "type": "text", "label": {"ru": "Архетип"}},
    {"id": "pilot", "type": "text", "label": {"ru": "Пилот"}},
    {"id": "level", "type": "number", "label": {"ru": "Опытность экипажа"}, "default": 1, "min": 1, "max": 20},
    {"id": "portrait", "type": "image", "label": {"ru": "Силуэт корабля"}},
    {"id": "engines", "type": "number", "label": {"ru": "Двигатели", "en": "Engines"}, "default": 10, "min": 1, "max": 30},
    {"id": "sensors", "type": "number", "label": {"ru": "Сенсоры", "en": "Sensors"}, "default": 10, "min": 1, "max": 30},
    {"id": "comms", "type": "number", "label": {"ru": "Связь", "en": "Comms"}, "default": 10, "min": 1, "max": 30},
    {"id": "hull", "type": "number", "label": {"ru": "Корпус", "en": "Hull"}, "default": 10, "min": 1, "max": 30},
    {"id": "systems", "type": "number", "label": {"ru": "Бортовые системы", "en": "Systems"}, "default": 10, "min": 1, "max": 30},
    {"id": "crew", "type": "number", "label": {"ru": "Экипаж", "en": "Crew"}, "default": 10, "min": 1, "max": 30},
    {"id": "engines_mod", "type": "computed", "label": {"ru": "Модификатор Двигателей"}, "formula": "floor((engines - 10) / 2)"},
    {"id": "sensors_mod", "type": "computed", "label": {"ru": "Модификатор Сенсоров"}, "formula": "floor((sensors - 10) / 2)"},
    {"id": "comms_mod", "type": "computed", "label": {"ru": "Модификатор Связи"}, "formula": "floor((comms - 10) / 2)"},
    {"id": "hull_mod", "type": "computed", "label": {"ru": "Модификатор Корпуса"}, "formula": "floor((hull - 10) / 2)"},
    {"id": "systems_mod", "type": "computed", "label": {"ru": "Модификатор Бортсистем"}, "formula": "floor((systems - 10) / 2)"},
    {"id": "crew_mod", "type": "computed", "label": {"ru": "Модификатор Экипажа"}, "formula": "floor((crew - 10) / 2)"},
    {"id": "prof", "type": "computed", "label": {"ru": "Бонус мастерства"}, "formula": "2 + floor((level - 1) / 4)"},
    {"id": "save_engines_prof", "type": "checkbox", "label": {"ru": "Владение: Двигатели"}},
    {"id": "save_engines", "type": "computed", "label": {"ru": "Двигатели"}, "formula": "engines_mod + (prof if save_engines_prof else 0)"},
    {"id": "save_sensors_prof", "type": "checkbox", "label": {"ru": "Владение: Сенсоры"}},
    {"id": "save_sensors", "type": "computed", "label": {"ru": "Сенсоры"}, "formula": "sensors_mod + (prof if save_sensors_prof else 0)"},
    {"id": "save_comms_prof", "type": "checkbox", "label": {"ru": "Владение: Связь"}},
    {"id": "save_comms", "type": "computed", "label": {"ru": "Связь"}, "formula": "comms_mod + (prof if save_comms_prof else 0)"},
    {"id": "save_hull_prof", "type": "checkbox", "label": {"ru": "Владение: Корпус"}},
    {"id": "save_hull", "type": "computed", "label": {"ru": "Корпус"}, "formula": "hull_mod + (prof if save_hull_prof else 0)"},
    {"id": "save_systems_prof", "type": "checkbox", "label": {"ru": "Владение: Бортсистемы"}},
    {"id": "save_systems", "type": "computed", "label": {"ru": "Бортсистемы"}, "formula": "systems_mod + (prof if save_systems_prof else 0)"},
    {"id": "save_crew_prof", "type": "checkbox", "label": {"ru": "Владение: Экипаж"}},
    {"id": "save_crew", "type": "computed", "label": {"ru": "Экипаж"}, "formula": "crew_mod + (prof if save_crew_prof else 0)"},
    {"id": "piloting_prof", "type": "select", "label": {"ru": "Владение: Пилотирование"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "piloting", "type": "computed", "label": {"ru": "Пилотирование"}, "formula": "engines_mod + prof * (2 if piloting_prof == \"expertise\" else 1 if piloting_prof == \"proficient\" else 0)"},
    {"id": "evasion_prof", "type": "select", "label": {"ru": "Владение: Уклонение"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "evasion", "type": "computed", "label": {"ru": "Уклонение"}, "formula": "engines_mod + prof * (2 if evasion_prof == \"expertise\" else 1 if evasion_prof == \"proficient\" else 0)"},
    {"id": "gunnery_prof", "type": "select", "label": {"ru": "Владение: Наводка"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "gunnery", "type": "computed", "label": {"ru": "Наводка"}, "formula": "sensors_mod + prof * (2 if gunnery_prof == \"expertise\" else 1 if gunnery_prof == \"proficient\" else 0)"},
    {"id": "scanning_prof", "type": "select", "label": {"ru": "Владение: Сканирование"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "scanning", "type": "computed", "label": {"ru": "Сканирование"}, "formula": "sensors_mod + prof * (2 if scanning_prof == \"expertise\" else 1 if scanning_prof == \"proficient\" else 0)"},
    {"id": "stealth_prof", "type": "select", "label": {"ru": "Владение: Маскировка"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "stealth", "type": "computed", "label": {"ru": "Маскировка"}, "formula": "sensors_mod + prof * (2 if stealth_prof == \"expertise\" else 1 if stealth_prof == \"proficient\" else 0)"},
    {"id": "engineering_prof", "type": "select", "label": {"ru": "Владение: Инженерия"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "engineering", "type": "computed", "label": {"ru": "Инженерия"}, "formula": "systems_mod + prof * (2 if engineering_prof == \"expertise\" else 1 if engineering_prof == \"proficient\" else 0)"},
    {"id": "negotiate_prof", "type": "select", "label": {"ru": "Владение: Переговоры"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "negotiate", "type": "computed", "label": {"ru": "Переговоры"}, "formula": "comms_mod + prof * (2 if negotiate_prof == \"expertise\" else 1 if negotiate_prof == \"proficient\" else 0)"},
    {"id": "command_prof", "type": "select", "label": {"ru": "Владение: Командование"}, "options": [{"value": "none", "label": {"ru": "Нет"}}, {"value": "proficient", "label": {"ru": "Владение"}}, {"value": "expertise", "label": {"ru": "Компетентность"}}]},
    {"id": "command", "type": "computed", "label": {"ru": "Командование"}, "formula": "crew_mod + prof * (2 if command_prof == \"expertise\" else 1 if command_prof == \"proficient\" else 0)"},
    {"id": "ac_base", "type": "number", "label": {"ru": "Базовое уклонение"}, "default": 11, "min": 0, "max": 30},
    {"id": "shield", "type": "checkbox", "label": {"ru": "Экран-отражатель"}},
    {"id": "ac_bonus", "type": "number", "label": {"ru": "Прочие бонусы к КД"}, "default": 0, "min": -20, "max": 20},
    {"id": "ac", "type": "computed", "label": {"ru": "Уклонение/защита (КД)"}, "formula": "ac_base + engines_mod + (2 if shield else 0) + ac_bonus"},
    {"id": "initiative", "type": "computed", "label": {"ru": "Инициатива (манёвр)"}, "formula": "engines_mod"},
    {"id": "hp_bonus", "type": "number", "label": {"ru": "Поправка к целостности"}, "default": 0, "min": -100, "max": 500},
    {"id": "hp", "type": "resource", "label": {"ru": "Целостность корпуса"}, "max_formula": "max(1, 20 + hull_mod + hp_bonus)"},
    {"id": "missiles", "type": "resource", "label": {"ru": "Ракеты"}, "default_max": 4},
    {"id": "torpedoes", "type": "resource", "label": {"ru": "Плазменные торпеды"}, "default_max": 0},
    {"id": "spares", "type": "resource", "label": {"ru": "Запчасти"}, "default_max": 2},
    {"id": "attacks", "type": "list", "label": {"ru": "Оружие"}, "item": {"name": {"type": "text", "label": {"ru": "Название"}}, "bonus": {"type": "number", "label": {"ru": "Бонус атаки"}}, "damage": {"type": "text", "label": {"ru": "Урон"}}, "damage_type": {"type": "text", "label": {"ru": "Тип урона"}}, "ammo_resource": {"type": "text", "label": {"ru": "Боезапас (id ресурса)"}}, "notes": {"type": "text", "label": {"ru": "Заметки"}}}},
    {"id": "cargo", "type": "list", "label": {"ru": "Трюм"}, "item": {"name": {"type": "text", "label": {"ru": "Груз"}}, "qty": {"type": "number", "label": {"ru": "Кол-во"}}, "notes": {"type": "text", "label": {"ru": "Заметки"}}}},
    {"id": "features", "type": "longtext", "label": {"ru": "Особенности и чертежи"}},
    {"id": "proficiencies", "type": "longtext", "label": {"ru": "Документация экипажа"}},
    {"id": "notes", "type": "longtext", "label": {"ru": "Заметки"}}
  ],
  "layout": [
    {"section": {"ru": "Основное"}, "cols": 4, "items": ["portrait", "name", "race", "char_class", "pilot", "level", "prof"]},
    {"section": {"ru": "Системы корабля"}, "cols": 6, "items": ["engines", "sensors", "comms", "hull", "systems", "crew", "engines_mod", "sensors_mod", "comms_mod", "hull_mod", "systems_mod", "crew_mod"]},
    {"section": {"ru": "Спасброски систем"}, "cols": 6, "items": ["save_engines_prof", "save_sensors_prof", "save_comms_prof", "save_hull_prof", "save_systems_prof", "save_crew_prof", "save_engines", "save_sensors", "save_comms", "save_hull", "save_systems", "save_crew"]},
    {"section": {"ru": "Экипаж и навыки"}, "cols": 2, "items": ["piloting_prof", "piloting", "evasion_prof", "evasion", "gunnery_prof", "gunnery", "scanning_prof", "scanning", "stealth_prof", "stealth", "engineering_prof", "engineering", "negotiate_prof", "negotiate", "command_prof", "command"]},
    {"section": {"ru": "Бой"}, "cols": 4, "items": ["hp", "hp_bonus", "ac", "ac_base", "shield", "ac_bonus", "initiative", "attacks"]},
    {"section": {"ru": "Боеприпасы и трюм"}, "cols": 2, "items": ["missiles", "torpedoes", "spares", "cargo"]},
    {"section": {"ru": "Особенности и заметки"}, "cols": 1, "items": ["features", "proficiencies", "notes"]}
  ],
  "bindings": {
    "checks": {
      "engines": {"label": {"ru": "Двигатели"}, "bonus": "engines_mod"},
      "sensors": {"label": {"ru": "Сенсоры"}, "bonus": "sensors_mod"},
      "comms": {"label": {"ru": "Связь"}, "bonus": "comms_mod"},
      "hull": {"label": {"ru": "Корпус"}, "bonus": "hull_mod"},
      "systems": {"label": {"ru": "Бортовые системы"}, "bonus": "systems_mod"},
      "crew": {"label": {"ru": "Экипаж"}, "bonus": "crew_mod"},
      "piloting": {"label": {"ru": "Пилотирование"}, "bonus": "piloting"},
      "evasion": {"label": {"ru": "Уклонение"}, "bonus": "evasion"},
      "gunnery": {"label": {"ru": "Наводка"}, "bonus": "gunnery"},
      "scanning": {"label": {"ru": "Сканирование"}, "bonus": "scanning"},
      "stealth": {"label": {"ru": "Маскировка"}, "bonus": "stealth"},
      "engineering": {"label": {"ru": "Инженерия"}, "bonus": "engineering"},
      "negotiate": {"label": {"ru": "Переговоры"}, "bonus": "negotiate"},
      "command": {"label": {"ru": "Командование"}, "bonus": "command"}
    },
    "saves": {
      "engines": {"label": {"ru": "Спасбросок Двигателей"}, "bonus": "save_engines"},
      "sensors": {"label": {"ru": "Спасбросок Сенсоров"}, "bonus": "save_sensors"},
      "comms": {"label": {"ru": "Спасбросок Связи"}, "bonus": "save_comms"},
      "hull": {"label": {"ru": "Спасбросок Корпуса"}, "bonus": "save_hull"},
      "systems": {"label": {"ru": "Спасбросок Бортовых систем"}, "bonus": "save_systems"},
      "crew": {"label": {"ru": "Спасбросок Экипажа"}, "bonus": "save_crew"}
    },
    "hp": "hp",
    "ac": "ac",
    "initiative": "initiative",
    "attacks": {"field": "attacks", "name": "name", "bonus": "bonus", "damage": "damage", "damage_type": "damage_type", "ammo_resource": "ammo_resource"}
  }
}
