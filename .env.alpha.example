# ============================================================================
# AI DnD — профиль АЛЬФА-СТЕНДА для тестирования (docker compose).
# Скопируйте в .env и заполните плейсхолдеры:  cp .env.alpha.example .env
# Аккаунты тестовые и ценности не представляют: демо-регистрация без
# подтверждения email, щедрые лимиты кредитов, реальный ИИ (DeepSeek).
# Файл .env в git не попадает. НЕ коммитьте реальные ключи и пароли.
#
# Переход на строгий prod позже: AI_DND_ENVIRONMENT=prod + AI_DND_DEMO_AUTH=false
# + HTTPS перед стендом (TLS-терминатор) + настроенный SMTP (AI_DND_SMTP_*) —
# см. .env.example и раздел «Прод-флаги» в README.
# ============================================================================

# --- PostgreSQL (сервис db) -------------------------------------------------
POSTGRES_USER=ai_dnd
# ОБЯЗАТЕЛЬНО поменяйте пароль-заглушку на свой.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_dnd

# --- Веб-интерфейс ----------------------------------------------------------
# Порт, на котором nginx отдаёт игру: http://localhost:8080
WEB_PORT=8080

# --- Основные настройки бэкенда (префикс AI_DND_) ---------------------------
# ОБЯЗАТЕЛЬНО dev для альфа-стенда по HTTP: только dev даёт не-Secure cookie.
# В prod/test cookie становятся Secure и вход по обычному http:// ломается.
AI_DND_ENVIRONMENT=dev
AI_DND_LOG_LEVEL=INFO
AI_DND_LOG_FORMAT=json

# Подключения к сервисам compose (хосты db и redis — имена сервисов).
# Пароль в URL должен совпадать с POSTGRES_PASSWORD выше.
AI_DND_DATABASE_URL=postgresql+asyncpg://ai_dnd:change-me@db:5432/ai_dnd
AI_DND_REDIS_URL=redis://redis:6379/0

# Секрет подписи сессий и токенов identity. ОБЯЗАТЕЛЬНО поменяйте:
# длинная случайная строка, например `openssl rand -hex 32`.
AI_DND_SECRET_KEY=change-me

# Ключ DeepSeek (https://platform.deepseek.com/api_keys).
# Без него ИИ-ведущий не работает — для альфы ключ обязателен.
AI_DND_DEEPSEEK_API_KEY=change-me

# Публичный адрес портала.
AI_DND_BASE_URL=http://localhost:8080

# --- Альфа-флаги ------------------------------------------------------------
# Демо-авторизация: тестовые аккаунты, регистрация без подтверждения email.
AI_DND_DEMO_AUTH=true
# Реальный ИИ для альфы (не заглушка). Расходы идут на баланс DeepSeek.
AI_DND_FAKE_LLM=false

# --- Биллинг (префикс AI_DND_BILLING_) — щедрые лимиты для тестировщиков ----
# Тестировщики не платят: кредиты не должны блокировать игру.
# Курс: 1 кредит = $0.0001 (10 000 кредитов = $1).
# Ежедневные бесплатные кредиты: 100 000 = $10 в день.
AI_DND_BILLING_DAILY_FREE_CREDITS=100000
# Лимиты расхода: пользователь в день/месяц, сессия в день (кредиты).
AI_DND_BILLING_USER_DAILY_SPEND_CREDITS=100000
AI_DND_BILLING_USER_MONTHLY_SPEND_CREDITS=1000000
AI_DND_BILLING_SESSION_DAILY_SPEND_CREDITS=100000
# Глобальный USD-предохранитель платформы: защита реального баланса DeepSeek.
AI_DND_BILLING_GLOBAL_DAILY_USD=20.00
AI_DND_BILLING_GLOBAL_MONTHLY_USD=300.00