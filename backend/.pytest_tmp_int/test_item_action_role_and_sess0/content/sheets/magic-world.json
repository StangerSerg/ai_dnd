{
  "id": "magic-world",
  "version": 1,
  "name": {
    "ru": "Карточка мага мира"
  },
  "ruleset": "magic-world@1",
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": {
        "ru": "Имя"
      }
    },
    {
      "id": "race",
      "type": "text",
      "label": {
        "ru": "Происхождение"
      }
    },
    {
      "id": "char_class",
      "type": "text",
      "label": {
        "ru": "Призвание"
      },
      "default": "Маг мира"
    },
    {
      "id": "portrait",
      "type": "image",
      "label": {
        "ru": "Портрет"
      }
    },
    {
      "id": "str",
      "type": "number",
      "label": {
        "ru": "Физическая сила"
      },
      "default": 10,
      "min": 1,
      "max": 30
    },
    {
      "id": "str_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус: Физическая сила"
      },
      "formula": "floor((str - 10) / 2)"
    },
    {
      "id": "dex",
      "type": "number",
      "label": {
        "ru": "Подвижность"
      },
      "default": 12,
      "min": 1,
      "max": 30
    },
    {
      "id": "dex_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус: Подвижность"
      },
      "formula": "floor((dex - 10) / 2)"
    },
    {
      "id": "con",
      "type": "number",
      "label": {
        "ru": "Стойкость"
      },
      "default": 12,
      "min": 1,
      "max": 30
    },
    {
      "id": "con_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус: Стойкость"
      },
      "formula": "floor((con - 10) / 2)"
    },
    {
      "id": "int",
      "type": "number",
      "label": {
        "ru": "Познание магии"
      },
      "default": 14,
      "min": 1,
      "max": 30
    },
    {
      "id": "int_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус: Познание магии"
      },
      "formula": "floor((int - 10) / 2)"
    },
    {
      "id": "wis",
      "type": "number",
      "label": {
        "ru": "Чутьё мира"
      },
      "default": 10,
      "min": 1,
      "max": 30
    },
    {
      "id": "wis_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус: Чутьё мира"
      },
      "formula": "floor((wis - 10) / 2)"
    },
    {
      "id": "cha",
      "type": "number",
      "label": {
        "ru": "Влияние"
      },
      "default": 10,
      "min": 1,
      "max": 30
    },
    {
      "id": "cha_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус: Влияние"
      },
      "formula": "floor((cha - 10) / 2)"
    },
    {
      "id": "ac",
      "type": "computed",
      "label": {
        "ru": "Магическая защита (включает Ледяной щит +2)"
      },
      "formula": "13 + dex_mod"
    },
    {
      "id": "initiative",
      "type": "computed",
      "label": {
        "ru": "Инициатива"
      },
      "formula": "dex_mod"
    },
    {
      "id": "hp",
      "type": "resource",
      "label": {
        "ru": "Жизненная сила"
      },
      "max_formula": "26 + con_mod"
    },
    {
      "id": "spell_ability",
      "type": "select",
      "label": {
        "ru": "Основа водного лечения"
      },
      "options": [
        {
          "value": "int",
          "label": {
            "ru": "Познание магии"
          }
        }
      ],
      "default": "int"
    },
    {
      "id": "spell_mod",
      "type": "computed",
      "label": {
        "ru": "Бонус водного лечения"
      },
