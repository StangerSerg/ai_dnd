# Скопируйте в .env и поменяйте под себя. Файл .env в git не попадает.

# dev | test | prod
AI_DND_ENVIRONMENT=dev
# DEBUG | INFO | WARNING | ERROR
AI_DND_LOG_LEVEL=INFO
# console (для разработки) | json (для сервера)
AI_DND_LOG_FORMAT=console

AI_DND_DATABASE_URL=postgresql+asyncpg://ai_dnd:ai_dnd@localhost:5432/ai_dnd
AI_DND_REDIS_URL=redis://localhost:6379/0

# Папка со встроенным контентом. По умолчанию — content/ в корне репозитория.
# AI_DND_CONTENT_DIR=/path/to/content

# Ключ DeepSeek (https://platform.deepseek.com/api_keys). Без него ИИ-функции не работают.
AI_DND_DEEPSEEK_API_KEY=
# Модели, цены и настройки задач ИИ. По умолчанию — backend/config/llm.yaml.
# AI_DND_LLM_CONFIG=/path/to/llm.yaml
